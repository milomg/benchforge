{
  "name": "benchforge",
  "version": "0.1.11",
  "type": "module",
  "bin": "bin/benchforge",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "example": "bin/benchforge --url file://$PWD/examples/index.html --gc-stats --heap-sample",
    "fix": "biome check --fix --unsafe --error-on-warnings",
    "lint": "biome check --error-on-warnings",
    "prepublishOnly": "run-s lint build",
    "test": "vitest --hideSkippedTests --exclude '**/*.e2e.test.ts'",
    "test:e2e": "vitest run '.e2e.'",
    "test:once": "vitest run --exclude '**/*.e2e.test.ts'",
    "typecheck": "tsgo",
    "prepush": "run-s fix typecheck test:once build"
  },
  "publishConfig": {
    "bin": {
      "benchforge": "dist/benchforge.mjs"
    }
  },
  "dependencies": {
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.0",
    "table": "^6.9.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.0",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260220.1",
    "npm-run-all": "^4.1.5",
    "tsdown": "0.20.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
